ui-onboarding:
  welcomeNoticeVersion: 2026-08-13.1
permission:
  defaultPreset: danger-full-access
agent-presets:
  default: ptc
agent-default-model:
provider:
model:
llm-pi-ai:
  providers:
    nvidia:
      models:
        - id: minimaxai/minimax-m3
          name: MiniMax-M3
          contextWindow: 1000000
          maxTokens: 16384
        - id: moonshotai/kimi-k2.6
          name: Kimi K2.6
          contextWindow: 262144
          maxTokens: 262144
        - id: openai/gpt-oss-120b
          name: GPT-OSS-120B
          contextWindow: 128000
          maxTokens: 8192
        - id: z-ai/glm-5.2
          name: GLM-5.2
          contextWindow: 1000000
          maxTokens: 131072
      apiKeyEnv: <MASKED>
    wangchuan:
      apiKeyEnv: <MASKED>
      api: openai-responses
      baseURL: https://api.123uq.com/v1
      models:
        - id: grok-4.6
          name: Grok 4.6
          reasoningEfforts:
            low: low
            medium: medium
            high: high
            xhigh: xhigh
    yyds:
      apiKeyEnv: <MASKED>
      api: openai-responses
      baseURL: https://www.yydsapi.uno/v1
      models:
        - id: gpt-5.5
          name: gpt-5.5
        - id: gpt-5.6-sol
          name: gpt-5.6-sol
          reasoningEfforts:
            off: null
            minimal: minimal
            low: low
            medium: medium
            high: high
            xhigh: xhigh
            max: max
        - id: gpt-5.6-terra
          name: gpt-5.6-terra
          reasoningEfforts:
            off: null
            minimal: minimal
            low: low
            medium: medium
            high: high
            xhigh: xhigh
            max: max
      displayName: yyds gpt
    luna:
      apiKeyEnv: <MASKED>
      api: openai-responses
      baseURL: https://www.yydsapi.uno/v1
      models:
        - id: gpt-5.6-luna
          name: gpt-5.6-luna
          reasoningEfforts:
            off:
            minimal: minimal
            low: low
            medium: medium
            high: high
            xhigh: xhigh
            max: max
      displayName: yyds luna
    yydsgrok:
      apiKeyEnv: <MASKED>
      api: openai-responses
      baseURL: https://www.yydsapi.uno/v1
      models:
        - id: grok-4.6
          name: Grok 4.6
          input:
            - text
            - image
          contextWindow: 200000
        - id: grok-imagine-video-1.5
          name: Grok Imagine Video 1.5
    yydsglm:
      apiKeyEnv: <MASKED>
      api: openai-responses
      baseURL: https://www.yydsapi.uno/v1
      models:
        - id: glm-5.3-flash
          name: glm-5.3-flash
          contextWindow: 1000000
          reasoningEfforts:
            low: low
            high: high
            max: max
        - id: deepseek-v4-flash
          name: deepseek-v4-flash
          contextWindow: 1000000
          maxTokens: 330000
    cat:
      apiKeyEnv: <MASKED>
      api: openai-completions
      baseURL: https://aicat.api.sumnece.com/v1
      models:
        - id: glm-5.3-flash
          name: glm-5.3-flash
          contextWindow: 1000000
          maxTokens: 372000
          input:
            - text
            - image
          reasoningEfforts:
            low: low
            high: high
            max: max
        - id: deepseek-v4.1-flash
          name: deepseek-v4.1-flash
          contextWindow: 1000000
          input:
            - text
            - image
          maxTokens: 372000
    newapi:
      apiKeyEnv: <MASKED>
      api: openai-responses
      baseURL: http://localhost:3000/v1
      models:
        - id: glm-5.3-flash
          contextWindow: 1000000
        - id: gpt-5.6-luna
        - id: gpt-5.6-sol
        - id: gpt-5.6-terra
        - id: gpt-image-2
        - id: grok-4.6
          contextWindow: 200000
    d1:
      apiKeyEnv: <MASKED>
      api: openai-completions
      baseURL: https://d1api.xin/v1
      models:
        - id: deepseek-v4.1-flash
          name: deepseek-v4.1-flash
          contextWindow: 1000000
          maxTokens: 350000
          input:
            - text
            - image
          reasoningEfforts:
            low: low
            high: high
            max: max
        - id: glm-5.3-flash
          name: glm-5.3-flash
          contextWindow: 1000000
          maxTokens: 320000
          input:
            - text
            - image
          reasoningEfforts:
            low: low
            medium: medium
            high: high

web-search-deepseek:
  maxUses: 10
pet:
  visible: false
  size: 160
  right: 0
  bottom: 41
  name: angel
  enabled: false
ui-theme:
  preference: dark
skin-wallpaper:
  enabled: false
  dim: 40
  wallpaperOpacity: 100
skin-background:
  backgroundOpacity: 0
  backgroundBlurEmpty: 0
  backgroundBlurContent: 0
  enabled: false
skin-custom-theme:
  applied: false
describe-image:
  baseURL: https://www.yydsapi.uno/v1
  apiKey: <MASKED>
  model: gpt-5.6-luna
task-board:
  preventIdleSleep: true
  announceToAgent: true
dsh-context:
  defaultTrendMode: total
subagent-model-selection:
  enabled: true
  allowedModels:
    - provider: newapi
      model: grok-4.6
    - provider: newapi
      model: gpt-5.6-terra
    - provider: newapi
      model: gpt-5.6-sol
    - provider: newapi
      model: gpt-5.6-luna
    - provider: newapi
      model: glm-5.3-flash
    - provider: cat
      model: glm-5.3-flash
    - provider: cat
      model: glm-5.3
    - provider: cat
      model: deepseek-v4-pro
    - provider: cat
      model: deepseek-v4-flash
    - provider: yydsglm
      model: glm-5.3-flash
    - provider: yydsgrok
      model: grok-4.6
    - provider: luna
      model: gpt-5.6-luna
    - provider: yyds
      model: gpt-5.6-terra
    - provider: yyds
      model: gpt-5.6-sol
    - provider: yyds
      model: gpt-5.5
    - provider: deepseek-official
      model: deepseek-v4-flash
    - provider: deepseek-official
      model: deepseek-v4-pro
    - provider: deepseek-official
      model: deepseek-v4-flash-vision-exp
dsh-better-sidebar:
  pluginSettings:
    editor:
      openWith:
        sshHost: ""
        customEditors: []
        pinned:
          - explorer
  agentOpenTools: true
# ---------------------------------------------------------------------------
# dsh-mnemon：关闭「空闲 30 秒后自动写入记忆」的后台复盘
# ---------------------------------------------------------------------------
# idleReview.enabled=false 只停用这一条自动维护流程：
#   - 已完成回合满足活动门槛后，不再等待 idleReviewMs（默认 30000ms）
#     派发后台子 Agent 去自动整理/写入记忆；
#   - 显式写入、引导式写回 cue、召回、记忆条、存入记忆按钮全部保留。
# 想恢复默认：删除下面这行 enabled: false（或整段 mnemon）。
# 想连「引导模型主动写记忆的 cue」也一起关掉，另加：writebackMode: off
# ---------------------------------------------------------------------------
mnemon:
  idleReview:
    enabled: false

# ---------------------------------------------------------------------------
# dsh-free-search：web_search 引擎选择（默认 bing；此处改为 tavily 账号档）
# API key 存于 ~/.dsh/.credentials.yaml 的 TAVILY_API_KEY（凭据中心优先级最高）。
# 改回免费引擎：把 provider 改成 bing / ddg，或在设置页切换。
# ---------------------------------------------------------------------------
free-search:
  provider: tavily
  cache: true
  cacheTtl: 5
  lang: zh
