    - provider: yyds
      model: gpt-5.6-terra
    - provider: yyds
      model: gpt-5.6-sol
    - provider: yyds
      model: gpt-5.5
    - provider: deepseek-official
      model: deepseek-v4-flash
    - provider: deepseek-official
      model: deepseek-v4-pro
    - provider: deepseek-official
      model: deepseek-v4-flash-vision-exp
    - provider: minimaxaaaa
      model: stealth/space-bunny-alpha
dsh-better-sidebar:
  pluginSettings:
    editor:
      openWith:
        sshHost: ""
        customEditors: []
        pinned:
          - explorer
  agentOpenTools: true
# ---------------------------------------------------------------------------
# dsh-mnemon：关闭「空闲 30 秒后自动写入记忆」的后台复盘
# ---------------------------------------------------------------------------
# idleReview.enabled=false 只停用这一条自动维护流程：
#   - 已完成回合满足活动门槛后，不再等待 idleReviewMs（默认 30000ms）
#     派发后台子 Agent 去自动整理/写入记忆；
#   - 显式写入、引导式写回 cue、召回、记忆条、存入记忆按钮全部保留。
# 想恢复默认：删除下面这行 enabled: false（或整段 mnemon）。
# 想连「引导模型主动写记忆的 cue」也一起关掉，另加：writebackMode: off
# ---------------------------------------------------------------------------
mnemon:
  idleReview:
    enabled: false
  memoryTopology:
    layers:
      runtime:
        enabled: false

# ---------------------------------------------------------------------------
# dsh-free-search：web_search 引擎选择（默认 bing；此处改为 tavily 账号档）
# API key 存于 ~/.dsh/.credentials.yaml 的 TAVILY_API_KEY（凭据中心优先级最高）。
# 改回免费引擎：把 provider 改成 bing / ddg，或在设置页切换。
# ---------------------------------------------------------------------------
free-search:
  provider: tavily
  cache: true
  cacheTtl: 5
  lang: zh
remote-web-ui:
  requirePairingForLan: true
  lanBind: true
  # 仅局域网模式：关掉用不了的 quick tunnel（域名随机 + fence 信任对不上，
  # 手机登录后实时通道一直重连）。开启公网请改用命名隧道令牌 + publicBaseUrl。
  autoTunnel: true
  offlineAfterMs: 250000000
dsh-web-ui-market:
  enabled: false
mnemon-view-8887a1728307a1ff:
  strategyTypeId: default-three-tier
  entries:
    include:mnemon-strategy-light-context:
      enabled: false
      config: {}
    include:mnemon-strategy-scoped:
      enabled: true
      config: {}
