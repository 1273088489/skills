+  // The tsx source launcher projects workspace specifiers to `src` (its tsconfig
+  // paths reach workspace importers), while `runtime` resolution mounts plugin
+  // entries from built `lib/` — one package evaluated twice, so module-private
+  // symbols (the tool scheduler key) mismatch and every tool call fails with
+  // "Cannot read properties of undefined (reading 'prepare')". Disk links keep
+  // the whole graph on one plane for source launches; built and pkg launches
+  // run `lib/` throughout and keep runtime.
+  const sourceLaunch = import.meta.url.endsWith('.ts')
+  const resolutionMode = packaged ? 'runtime' : options.resolutionMode ?? (sourceLaunch ? 'link' : 'runtime')
