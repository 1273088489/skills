diff --git a/packages/llm/llm-pi-ai/src/catalog.ts b/packages/llm/llm-pi-ai/src/catalog.ts
index d626c1ac71..f42e324df0 100644
--- a/packages/llm/llm-pi-ai/src/catalog.ts
+++ b/packages/llm/llm-pi-ai/src/catalog.ts
@@ -670,6 +670,32 @@ interface ModelReasoning {
   thinkingLevelMap?: ThinkingLevelMap
 }
 
+/** Infer reasoning capability for a hand-declared model from its id. */
+function inferHandDeclaredReasoning(
+  modelId: string,
+  api: string,
+): { reasoning: true; thinkingLevelMap: ThinkingLevelMap; compat: OpenAICompletionsCompat } {
+  const id = modelId.toLowerCase()
+  // Every hand-declared third-party model exposes the same thinking ladder:
+  // low / high / xhigh / max, regardless of vendor or id. Unusable levels are
+  // pinned null so the selector only offers what dispatch can actually send,
+  // while a non-thinking model misbehaves only once the user picks a level —
+  // the provider's own error is the feedback.
+  const thinkingLevelMap: ThinkingLevelMap = {
+    off: null, minimal: null, low: 'low', medium: null, high: 'high', xhigh: 'xhigh', max: 'max',
+  }
+  // The wire protocol still depends on the vendor: deepseek-family models
+  // negotiate with the deepseek thinking format; everything else openai.
+  const thinkingFormat: PiAiThinkingFormat = id.includes('deepseek') ? 'deepseek' : 'openai'
+  return {
+    reasoning: true,
+    thinkingLevelMap,
+    compat: api === 'openai-completions'
+      ? { thinkingFormat, supportsReasoningEffort: true }
+      : {},
+  }
+}
+
 /**
  * Resolve one model's reasoning capability from its declared efforts.
  *
@@ -691,15 +717,13 @@ function resolveModelReasoning(
   provider: string,
   entry: PiAiModelProfile,
   base: Model<Api> | undefined,
+  api: string,
 ): ModelReasoning {
   const efforts = entry.reasoningEfforts
   if (efforts === undefined) {
-    // Reasoning rides the installed entry or is absent: a bare capability flag
-    // would make pi-ai advertise effort levels with no `thinkingLevelMap` to
-    // spell them, and no listing endpoint reports a model's reasoning
-    // protocol. The entry's map (when any) arrives through the `...base`
-    // spread in the model literal.
-    return { reasoning: base?.reasoning ?? false }
+    if (base === undefined) return inferHandDeclaredReasoning(entry.id, api)
+    // Catalog models keep the installed catalog capability and map.
+    return { reasoning: base.reasoning }
   }
   // The installed entry's map may ride along through `...base`; pi-ai never
   // reads it on a non-reasoning model, so stripping it is not worth a field
@@ -786,7 +810,12 @@ function resolveModelCompat(
     }
     configured[field] = value
   }
-  if (Object.keys(configured).length === 0) return {}
+  if (Object.keys(configured).length === 0) {
+    // Hand-declared models have no catalog compat metadata. Mirror the
+    // reasoning fallback so visible choices and wire dispatch agree.
+    if (base === undefined) return { compat: inferHandDeclaredReasoning(entry.id, api).compat }
+    return {}
+  }
   // The installed entry's compat matches the entry's OWN api — a route-level
   // `api` repoint (an anthropic catalog served through an OpenAI-compatible
   // gateway) leaves `base.compat` in the other protocol's shape, so it is
@@ -925,7 +954,7 @@ export function resolveRouteModels(
       cost: base?.cost ?? NO_COST,
       contextWindow,
       maxTokens,
-      ...resolveModelReasoning(provider, entry, base),
+      ...resolveModelReasoning(provider, entry, base, api),
       ...resolveModelCompat(provider, entry, request.compat, base, api),
     }
   }
