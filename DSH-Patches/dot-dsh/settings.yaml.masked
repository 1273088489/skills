ui-onboarding:
  welcomeNoticeVersion: 2026-08-13.1
permission:
  defaultPreset: danger-full-access
agent-presets:
  default: ptc
agent-default-model:
provider:
model:
llm-pi-ai:
  providers:
    wangchuan:
      apiKeyEnv: WANGCHUAN_API_KEY
      api: openai-responses
      baseURL: https://api.123uq.com/v1
      models:
        - id: grok-4.6
          name: Grok 4.6
          reasoningEfforts:
            low: low
            medium: medium
            high: high
            xhigh: xhigh
    yyds:
      apiKeyEnv: YYDS_API_KEY
      api: openai-responses
      baseURL: https://www.yydsapi.uno/v1
      models:
        - id: gpt-5.6-sol
          name: gpt-5.6-sol
          input:
            - text
            - image
          reasoningEfforts:
            off: null
            minimal: minimal
            low: low
            medium: medium
            high: high
            xhigh: xhigh
            max: max
        - id: gpt-5.6-terra
          name: gpt-5.6-terra
          input:
            - text
            - image
          reasoningEfforts:
            off: null
            minimal: minimal
            low: low
            medium: medium
            high: high
            xhigh: xhigh
            max: max
        - id: gpt-6-astra
          name: GPT-6 Astra
          input:
            - text
            - image
      displayName: yyds gpt
    luna:
      apiKeyEnv: LUNA_API_KEY
      api: openai-responses
      baseURL: https://www.yydsapi.uno/v1
      models:
        - id: gpt-5.6-luna
          name: gpt-5.6-luna
          reasoningEfforts:
            off:
            minimal: minimal
            low: low
            medium: medium
            high: high
            xhigh: xhigh
            max: max
