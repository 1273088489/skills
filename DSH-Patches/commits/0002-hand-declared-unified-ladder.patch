---
 packages/llm/llm-pi-ai/src/catalog.ts        | 36 ++++++--------------
 packages/llm/llm-pi-ai/tests/catalog.spec.ts | 15 ++++----
 2 files changed, 18 insertions(+), 33 deletions(-)

diff --git a/packages/llm/llm-pi-ai/src/catalog.ts b/packages/llm/llm-pi-ai/src/catalog.ts
index 40d3d3cb4f..5b29dc998b 100644
--- a/packages/llm/llm-pi-ai/src/catalog.ts
+++ b/packages/llm/llm-pi-ai/src/catalog.ts
@@ -633,34 +633,20 @@ function inferHandDeclaredReasoning(
   api: string,
 ): { reasoning: true; thinkingLevelMap: ThinkingLevelMap; compat: OpenAICompletionsCompat } {
   const id = modelId.toLowerCase()
-  const mapFor = (levels: Readonly<Record<string, string | null>>): ThinkingLevelMap => ({
-    off: null, minimal: null, low: null, medium: null, high: null, xhigh: null, max: null, ...levels,
-  })
-  let map: ThinkingLevelMap
-  let thinkingFormat: PiAiThinkingFormat = 'openai'
-  if (id.includes('deepseek')) {
-    map = mapFor({ low: 'low', high: 'high', max: 'max' })
-    thinkingFormat = 'deepseek'
-  } else if (/gpt-5|(^|\/)o1($|\/)|(^|\/)o3($|\/)/.test(id)) {
-    map = mapFor({ minimal: 'minimal', low: 'low', medium: 'medium', high: 'high' })
-  } else if (/claude|sonnet|opus|haiku/.test(id)) {
-    map = mapFor({ low: 'low', medium: 'medium', high: 'high', xhigh: 'xhigh', max: 'max' })
-  } else if (/glm|qwen/.test(id)) {
-    map = mapFor({ low: 'low', medium: 'medium', high: 'high' })
-  } else if (/kimi|moonshot|k2/.test(id)) {
-    map = mapFor({ low: 'low', medium: 'medium', high: 'high', max: 'max' })
-  } else if (/minimax|(^|\/)m3($|\/)/.test(id)) {
-    map = mapFor({ low: 'low', medium: 'medium', high: 'high' })
-  } else {
-    // Selector fallback for ids nothing above recognizes: offer the full
-    // ladder so a thinking-capable gateway model is reachable without a
-    // declaration, while a non-thinking model only misbehaves once the user
-    // explicitly picks a level — the provider's error is the feedback.
-    map = mapFor({ low: 'low', medium: 'medium', high: 'high', xhigh: 'xhigh', max: 'max' })
+  // Every hand-declared third-party model exposes the same thinking ladder:
+  // low / high / xhigh / max, regardless of vendor or id. Unusable levels are
+  // pinned null so the selector only offers what dispatch can actually send,
+  // while a non-thinking model misbehaves only once the user picks a level —
+  // the provider's own error is the feedback.
+  const thinkingLevelMap: ThinkingLevelMap = {
+    off: null, minimal: null, low: 'low', medium: null, high: 'high', xhigh: 'xhigh', max: 'max',
   }
+  // The wire protocol still depends on the vendor: deepseek-family models
+  // negotiate with the deepseek thinking format; everything else openai.
+  const thinkingFormat: PiAiThinkingFormat = id.includes('deepseek') ? 'deepseek' : 'openai'
   return {
     reasoning: true,
-    thinkingLevelMap: map,
+    thinkingLevelMap,
     compat: api === 'openai-completions'
       ? { thinkingFormat, supportsReasoningEffort: true }
       : {},
diff --git a/packages/llm/llm-pi-ai/tests/catalog.spec.ts b/packages/llm/llm-pi-ai/tests/catalog.spec.ts
index 77f5fb160f..9784eee448 100644
--- a/packages/llm/llm-pi-ai/tests/catalog.spec.ts
+++ b/packages/llm/llm-pi-ai/tests/catalog.spec.ts
@@ -113,18 +113,17 @@ describe('hand-declared providers', () => {
     })
   })
 
-  it('offers the full thinking ladder for unrecognized hand-declared models', async () => {
+  it('offers the uniform thinking ladder for unrecognized hand-declared models', async () => {
     const server = await mockServer([])
     const ctx = await harness(gateway(`${server.url}/v1`))
 
-    // A hand-declared model (no installed catalog entry) receives inferred
-    // thinking levels from its id. The fallback offers the full ladder, so a
-    // thinking-capable gateway model is reachable without a declaration; a
-    // model that cannot think is unaffected until the user explicitly asks —
-    // at which point the provider's error is immediate feedback rather than
-    // a silent miss.
+    // A hand-declared model (no installed catalog entry) receives the same
+    // inferred thinking levels as every other third-party model, regardless
+    // of id: low / high / xhigh / max. A model that cannot think is
+    // unaffected until the user explicitly asks — at which point the
+    // provider's error is immediate feedback rather than a silent miss.
     expect((await ctx.llm.resolveModelInfo('acme-gateway', 'acme-large')).reasoning?.efforts.map(e => e.id))
-      .toEqual(['low', 'medium', 'high', 'xhigh', 'max'])
+      .toEqual(['low', 'high', 'xhigh', 'max'])
 
     // A catalog route is unaffected: its models carry the metadata that makes
     // `off` actually disable thinking.
