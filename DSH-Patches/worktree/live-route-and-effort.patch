diff --git a/packages/subagent/subagent/tests/child-agent-route.spec.ts b/packages/subagent/subagent/tests/child-agent-route.spec.ts
new file mode 100644
index 0000000000..4e5cf64207
--- /dev/null
+++ b/packages/subagent/subagent/tests/child-agent-route.spec.ts
@@ -0,0 +1,95 @@
+/**
+ * Child route resolution: a delegation follows the route the parent's latest
+ * request was actually served on, not the parent's creation-time seed options.
+ * The seed stays as the last tier, and an explicit per-child override still
+ * wins over everything — the one-shot driver and the continuation manager
+ * share this resolver, so both delegation shapes get the same tiers.
+ */
+
+import { describe, expect, it } from 'vitest'
+import type { Agent, AgentOptions } from '@deepseek-ai/dsh-agent'
+import type { ReasoningEffortId } from '@deepseek-ai/dsh-llm'
+import { parentLiveRoute, resolveChildAgentOptions } from '../src/child-agent.ts'
+
+/** A minimal Agent stand-in: only `options` and `session.requestHeader()` are read. */
+function stubAgent(
+  options: AgentOptions,
+  loggedConfig?: { provider?: string; model?: string },
+): Agent {
+  return {
+    options,
+    session: {
+      requestHeader: () => loggedConfig === undefined ? undefined : { config: loggedConfig },
+    },
+  } as unknown as Agent
+}
+
+describe('resolveChildAgentOptions route tiers', () => {
+  it('follows the parent live served route over the creation-time seed', () => {
+    const parent = stubAgent(
+      { provider: 'seed-provider', model: 'seed-model' },
+      { provider: 'live-provider', model: 'live-model' },
+    )
+    const options = resolveChildAgentOptions(parent, undefined, 1)
+    expect(options.provider).toBe('live-provider')
+    expect(options.model).toBe('live-model')
+  })
+
+  it('keeps an explicit per-request override above the live route', () => {
+    const parent = stubAgent(
+      { provider: 'seed-provider', model: 'seed-model' },
+      { provider: 'live-provider', model: 'live-model' },
+    )
+    const options = resolveChildAgentOptions(parent, { provider: 'pinned', model: 'pinned-model' }, 2)
+    expect(options.provider).toBe('pinned')
+    expect(options.model).toBe('pinned-model')
+    expect(options.subagentDepth).toBe(2)
+  })
+
+  it('falls back to the creation-time seed when no request was served yet', () => {
+    const parent = stubAgent({ provider: 'seed-provider', model: 'seed-model' })
+    const options = resolveChildAgentOptions(parent, undefined, 0)
+    expect(options.provider).toBe('seed-provider')
+    expect(options.model).toBe('seed-model')
+    expect(options.subagentDepth).toBe(0)
+  })
+
+  it('resolves field-wise when the served header is sparse', () => {
+    const parent = stubAgent(
+      { provider: 'seed-provider', model: 'seed-model' },
+      { provider: 'live-provider' },
+    )
+    const options = resolveChildAgentOptions(parent, undefined, 1)
+    expect(options.provider).toBe('live-provider')
+    expect(options.model).toBe('seed-model')
+  })
+
+  it('carries an explicit per-request reasoning effort into the child options', () => {
+    const parent = stubAgent(
+      { provider: 'seed-provider', model: 'seed-model' },
+      { provider: 'live-provider', model: 'live-model' },
+    )
+    const options = resolveChildAgentOptions(parent, { reasoningEffort: 'high' as ReasoningEffortId }, 1)
+    expect(options.provider).toBe('live-provider')
+    expect(options.model).toBe('live-model')
+    expect(options.reasoningEffort).toBe('high')
+  })
+
+  it('keeps seed-only maxTokens inheritance and stamps the depth', () => {
+    const parent = stubAgent({ maxTokens: 4096 }, { provider: 'live-provider', model: 'live-model' })
+    const options = resolveChildAgentOptions(parent, undefined, 3)
+    expect(options.maxTokens).toBe(4096)
+    expect(options.subagentDepth).toBe(3)
+  })
+})
+
+describe('parentLiveRoute', () => {
+  it('is empty for a session that never served a request', () => {
+    expect(parentLiveRoute(stubAgent({}))).toEqual({})
+  })
+
+  it('reports the latest served pair without inventing fields', () => {
+    expect(parentLiveRoute(stubAgent({}, { provider: 'p', model: 'm' })))
+      .toEqual({ provider: 'p', model: 'm' })
+  })
+})
